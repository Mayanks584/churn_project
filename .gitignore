# Data directories
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models
models/saved/*
models/artifacts/*
!models/saved/.gitkeep
!models/artifacts/.gitkeep

# Logs
logs/
*.log

# Reports (keep structure, not outputs)
reports/figures/*
reports/metrics/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Environments
venv/
env/
.env
*.env
.venv

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# MLflow
mlruns/
mlartifacts/

# Pytest
.pytest_cache/
.coverage
htmlcov/
